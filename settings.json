{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {"type": "command", "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/threejs-reminder.sh"},
          {"type": "command", "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/plan-mode-nudge.sh"},
          {"type": "command", "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/kit-drift-reminder.sh"}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "if": "Bash(git commit*)", "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/premium-review-reminder.sh"}
        ]
      }
    ]
  }
}
